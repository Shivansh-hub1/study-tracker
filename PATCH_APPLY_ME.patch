@@ -0,0 +1,104 @@
+"use client";
+
+type SoundType = "click" | "success" | "delete" | "pop" | "achievement" | "timer" | "whoosh" | "error";
+
+const SOUND_ENABLED_KEY = "ff_sound_enabled_v1";
+
+export function isSoundEnabled(): boolean {
+  try {
+    const v = localStorage.getItem(SOUND_ENABLED_KEY);
+    return v === null ? true : v === "1";
+  } catch { return true; }
+}
+export function setSoundEnabled(on: boolean) {
+  try { localStorage.setItem(SOUND_ENABLED_KEY, on ? "1" : "0"); } catch {}
+}
+
+let audioCtx: AudioContext | null = null;
+function getCtx(): AudioContext | null {
+  try {
+    if (audioCtx) return audioCtx;
+    const Ctx = (window as any).AudioContext || (window as any).webkitAudioContext;
+    if (!Ctx) return null;
+    audioCtx = new Ctx();
+    return audioCtx;
+  } catch { return null; }
+}
+
+export function playSound(type: SoundType = "click") {
+  if (!isSoundEnabled()) return;
+  try {
+    const ctx = getCtx();
+    if (!ctx) return;
+    if (ctx.state === "suspended") ctx.resume();
+
+    const now = ctx.currentTime;
+
+    const playTone = (freq: number, start: number, dur: number, vol = 0.3, wave: OscillatorType = "sine") => {
+      const o = ctx.createOscillator();
+      const g = ctx.createGain();
+      o.type = wave;
+      o.frequency.setValueAtTime(freq, start);
+      o.connect(g); g.connect(ctx.destination);
+      g.gain.setValueAtTime(0.001, start);
+      g.gain.exponentialRampToValueAtTime(vol, start + 0.02);
+      g.gain.exponentialRampToValueAtTime(0.001, start + dur);
+      o.start(start); o.stop(start + dur + 0.05);
+    };
+
+    switch (type) {
+      case "click":
+        playTone(800, now, 0.08, 0.15, "sine");
+        break;
+      case "pop":
+        playTone(600, now, 0.12, 0.25, "sine");
+        playTone(1200, now + 0.06, 0.12, 0.18, "sine");
+        break;
+      case "success": {
+        // cheerful triad
+        playTone(523, now, 0.18, 0.28, "sine"); // C5
+        playTone(659, now + 0.1, 0.18, 0.28, "sine"); // E5
+        playTone(784, now + 0.2, 0.28, 0.32, "sine"); // G5
+        break;
+      }
+      case "delete": {
+        playTone(400, now, 0.15, 0.22, "sawtooth");
+        playTone(200, now + 0.08, 0.25, 0.22, "sawtooth");
+        break;
+      }
+      case "achievement": {
+        playTone(880, now, 0.2, 0.35, "sine");
+        playTone(1108, now + 0.12, 0.2, 0.35, "sine");
+        playTone(1318, now + 0.24, 0.4, 0.4, "sine");
+        break;
+      }
+      case "timer": {
+        for (let i = 0; i < 3; i++) {
+          playTone(i % 2 === 0 ? 880 : 660, now + i * 0.22, 0.2, 0.35, "sine");
+        }
+        break;
+      }
+      case "whoosh": {
+        // noise-like whoosh using frequency sweep
+        const o = ctx.createOscillator();
+        const g = ctx.createGain();
+        const f = ctx.createBiquadFilter();
+        f.type = "bandpass"; f.frequency.value = 800; f.Q.value = 0.5;
+        o.type = "sine";
+        o.frequency.setValueAtTime(1200, now);
+        o.frequency.exponentialRampToValueAtTime(200, now + 0.25);
+        o.connect(f); f.connect(g); g.connect(ctx.destination);
+        g.gain.setValueAtTime(0.001, now);
+        g.gain.linearRampToValueAtTime(0.3, now + 0.02);
+        g.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
+        o.start(now); o.stop(now + 0.32);
+        break;
+      }
+      case "error": {
+        playTone(220, now, 0.3, 0.3, "sawtooth");
+        playTone(180, now + 0.15, 0.3, 0.3, "sawtooth");
+        break;
+      }
+    }
+  } catch {}
+}
