# ==============================================================================
# FocusFlow Study Tracker - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE / SITE CONFIGURATION (Required for SEO & Canonical URLs)
# ------------------------------------------------------------------------------
# The public base URL of your deployed app (without trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourstudytracker.vercel.app

# Google Search Console verification code (from the HTML Tag verification method)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required for Production)
# ------------------------------------------------------------------------------
# Secret key used to sign JWT auth cookies (e.g. generate via: openssl rand -hex 32)
ST_SECRET=your_super_secret_jwt_key_change_me_in_production

# ------------------------------------------------------------------------------
# 3. DATABASE (Optional - defaults to local SQLite if omitted)
# ------------------------------------------------------------------------------
# If deploying on Turso (libSQL cloud):
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------------------------
# 4. EMAIL / PASSWORD RESET (Optional - app runs without email)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password_or_smtp_key
# MAIL_FROM=FocusFlow <noreply@yourdomain.com>

# ------------------------------------------------------------------------------
# 5. CRON JOBS (Optional - for Vercel daily email / weekly digests)
# ------------------------------------------------------------------------------
# CRON_SECRET=your_cron_secret_key

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS (Optional)
# ------------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com
