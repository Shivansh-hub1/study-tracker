# ==============================================================================
# FocusFlow Study Tracker - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE / SITE CONFIGURATION (Required for SEO & Canonical URLs)
# ------------------------------------------------------------------------------
# The public base URL of your deployed app (without trailing slash)
NEXT_PUBLIC_SITE_URL=https://tracker.devshivansh.in

# Canonical domain (host only, e.g. tracker.devshivansh.in)
CANONICAL_HOST=tracker.devshivansh.in

# Google Search Console verification code (from the HTML Tag verification method)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code_here

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Required for Production)
# ------------------------------------------------------------------------------
# Secret key used to sign JWT auth cookies (e.g. generate via: openssl rand -hex 32)
ST_SECRET=your_super_secret_jwt_key_change_me_in_production

# Google OAuth 2.0 (for Google Login & Sign Up)
# Get from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs)
# Authorized redirect URIs:
#   - Production: https://tracker.devshivansh.in/api/auth/google/callback
#   - Local development: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: Optional custom redirect URI override (defaults to {origin}/api/auth/google/callback)
# GOOGLE_REDIRECT_URI=https://tracker.devshivansh.in/api/auth/google/callback
# Optional: For Google One Tap in browser (can be same as GOOGLE_CLIENT_ID)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. DATABASE (Optional - defaults to local SQLite if omitted)
# ------------------------------------------------------------------------------
# If deploying on Turso (libSQL cloud):
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ------------------------------------------------------------------------------
# 4. REDIS CACHE (Optional - for multi-instance ultra-fast caching on Vercel)
# ------------------------------------------------------------------------------
# Create a free Redis database at Upstash.com or via Vercel Marketplace (Upstash Redis):
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ------------------------------------------------------------------------------
# 5. EMAIL / PASSWORD RESET (Optional - app runs without email)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password_or_smtp_key
# MAIL_FROM=FocusFlow <noreply@yourdomain.com>

# ------------------------------------------------------------------------------
# 5. CRON JOBS (Optional - for Vercel daily email / weekly digests)
# ------------------------------------------------------------------------------
# CRON_SECRET=your_cron_secret_key

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS (Optional)
# ------------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com
